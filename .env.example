# Banco de dados
POSTGRES_DB=sistema_dri
POSTGRES_USER=sistema_dri
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://sistema_dri:troque-esta-senha@localhost:5432/sistema_dri

# Auth JWT
JWT_SECRET_KEY=troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Criptografia de tokens ML em repouso (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ML_TOKEN_ENCRYPTION_KEY=troque-esta-chave-fernet

# Integração Mercado Livre (criar app em https://developers.mercadolivre.com.br)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Em dev, use a URL pública do ngrok (ex: https://xxxx.ngrok-free.app/integrations/ml/callback)
ML_REDIRECT_URI=http://localhost:8000/integrations/ml/callback

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App
APP_NAME=Sistema DRI
API_ROOT_PATH=
